# -------------
# -- Bluesky account credentials
# At least one account did and password required
ACCOUNT_DID_1=
PASSWORD_1=
ACCOUNT_DID_2=
PASSWORD_2=

# -------------
# -- Account number used for the Word of the Day feature
# Set to the bot number you want to use this feature
WORD_OF_THE_DAY_BOT=

# -------------
# -- The number of log files to keep in /logs
# Leave empty to disable log file generation
# Set to 0 to delete ALL existing log files
LOG_AMOUNT=5
